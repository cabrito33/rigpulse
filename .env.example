# Environment Variables for RigPulse

# ─── Site URL (no trailing slash) ────────────────────────────────────────────
# Set this to your real domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Amazon Affiliate Tags ────────────────────────────────────────────────────
# Replace with your real tags from affiliate-program.amazon.com
NEXT_PUBLIC_AMAZON_TAG_GLOBAL=rigpulse-20      # amazon.com (EN / Global)
NEXT_PUBLIC_AMAZON_TAG_IBERIA=rigpulse-21      # amazon.es  (PT / ES / Iberia)

# ─── Google AdSense ───────────────────────────────────────────────────────────
# Leave empty to hide AdSlots in production (no dashed boxes shown)
# Set to your Publisher ID (ca-pub-XXXXXXXXXXXXXXXX) to enable ads
NEXT_PUBLIC_ADSENSE_CLIENT=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
